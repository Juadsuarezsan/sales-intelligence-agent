# --- LLM (Anthropic) -------------------------------------------------------
# Leave ANTHROPIC_API_KEY empty to run the deterministic offline fallback
# (heuristic planner/reflector/profile builder, template email, keyword judge).
ANTHROPIC_API_KEY=
# Pinned dated model ID used by the agent nodes (planner, reflector, builder, writer).
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Model used by the LLM-as-judge Quality Scorer. The spec asks for a stronger
# judge model than the worker; set it here when the key is available.
JUDGE_MODEL=claude-opus-5-5
# Timeout (seconds) and retry attempts for every Anthropic call.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3
# Price table used to compute cost_usd per request (USD per million tokens).
# Defaults match the public list price of the pinned model at the time of writing;
# override when prices change.
PRICE_INPUT_PER_MTOK=3.00
PRICE_OUTPUT_PER_MTOK=15.00

# --- Web search (Tavily: 1000 free searches/month, $0.001 after) -----------
TAVILY_API_KEY=
TAVILY_TIMEOUT_SECONDS=10
TAVILY_COST_PER_SEARCH_USD=0.001

# --- HackerNews Algolia (free, no key). Set to false to use the stub. -------
USE_REAL_HN=true
HN_TIMEOUT_SECONDS=8

# --- Website fetcher (httpx + selectolax) -----------------------------------
WEBSITE_FETCH_ENABLED=true
WEBSITE_TIMEOUT_SECONDS=8

# --- Agent loop budget ------------------------------------------------------
MAX_TOOL_CALLS_PER_COMPANY=8
MAX_REFLECTION_ITERATIONS=3

# --- Persistence ------------------------------------------------------------
# Leave DATABASE_URL empty to use the in-memory repository.
DATABASE_URL=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=8
RESULT_CACHE_TTL_SECONDS=3600

# --- HTTP API ---------------------------------------------------------------
# Comma-separated list of allowed origins. Never "*" in production.
CORS_ORIGINS=http://localhost:3000,https://juadsuarezsan.github.io
RATE_LIMIT=20/minute

# --- Observability (LangSmith) ---------------------------------------------
# Set LANGCHAIN_TRACING_V2=true and a LANGCHAIN_API_KEY to send LangGraph
# traces to LangSmith. Nothing is sent when unset.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=sales-intelligence-agent
LOG_LEVEL=INFO
